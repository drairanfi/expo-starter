{
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "i18next": "^26.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.13",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "start:staging": "APP_VARIANT=staging expo start --dev-client",
    "start:prod": "APP_VARIANT=production expo start --dev-client",
    "ios:dev": "APP_VARIANT=development expo run:ios",
    "ios:staging": "APP_VARIANT=staging expo run:ios",
    "ios:prod": "APP_VARIANT=production expo run:ios --configuration Release",
    "android:dev": "APP_VARIANT=development expo run:android",
    "android:staging": "APP_VARIANT=staging expo run:android",
    "android:prod": "APP_VARIANT=production expo run:android --variant release",
    "web": "expo start --web",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --clean",
    "prebuild:staging": "APP_VARIANT=staging expo prebuild --clean",
    "prebuild:prod": "APP_VARIANT=production expo prebuild --clean",
    "export:web:dev": "APP_VARIANT=development expo export --platform web",
    "export:web:staging": "APP_VARIANT=staging expo export --platform web",
    "export:web:prod": "APP_VARIANT=production expo export --platform web",
    "config:dev": "APP_VARIANT=development expo config --type public",
    "config:staging": "APP_VARIANT=staging expo config --type public",
    "config:prod": "APP_VARIANT=production expo config --type public",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "doctor": "expo-doctor",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "name": "expo-template"
}
