# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Continuous Native Generation: ios/ and android/ are generated by
# `npx expo prebuild` from app.config.ts. Never commit them.
/ios
/android

# Native signing material
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# env files: real files are local only, only *.example is tracked
.env
.env.*
!.env.*.example

# tests / typescript
coverage/
*.tsbuildinfo

# AI harness: personal settings, working plans and tool-generated indexes stay local
.claude/settings.local.json
.claude/plans/*
!.claude/plans/.gitkeep
.atl/
